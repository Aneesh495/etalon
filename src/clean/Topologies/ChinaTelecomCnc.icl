import StdEnv
import Etalon.Topologies.ChinaTelecomCnc
import Etalon.Topology.Graph
import Etalon.Physical.Roadm
import Etalon.Physical.Fiber

chinaTelecomCncNodeCount :== 60
chinaTelecomCncLinkCount :== 90

buildChinaTelecomCnc :: *OpticalGraph
buildChinaTelecomCnc =
    let g0 = createEmptyOpticalGraph
        g1 = addNodes g0 1
        g2 = addLinks g1
    in g2
where
    addNodes :: !*OpticalGraph !Int -> *OpticalGraph
    addNodes g idx
        | idx > chinaTelecomCncNodeCount = g
        = let node = createCdcRoadmNode idx ("ChinaTelecomCnc-" +++ toString idx) 4 32
              nextG = addNodeToGraph g node
          in addNodes nextG (idx + 1)

    addLinks :: !*OpticalGraph -> *OpticalGraph
    addLinks g =
        let links = [
                (1, 1, 2, 290.0, [3101]),
                (2, 2, 3, 290.0, [3102]),
                (3, 3, 4, 290.0, [3103]),
                (4, 4, 5, 290.0, [3104]),
                (5, 5, 6, 290.0, [3105]),
                (6, 6, 7, 290.0, [3106]),
