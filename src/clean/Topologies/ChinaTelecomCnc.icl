                (10, 10, 11, 290.0, [3110]),
                (11, 11, 12, 290.0, [3111]),
                (12, 12, 13, 290.0, [3112]),
                (13, 13, 14, 290.0, [3113]),
                (14, 14, 15, 290.0, [3114]),
                (15, 15, 16, 290.0, [3115]),
                (16, 16, 17, 290.0, [3116]),
                (17, 17, 18, 290.0, [3117]),
                (18, 18, 19, 290.0, [3118]),
                (19, 19, 20, 290.0, [3119]),
                (20, 20, 21, 290.0, [3120]),
                (21, 21, 22, 290.0, [3121]),
                (22, 22, 23, 290.0, [3122]),
                (23, 23, 24, 290.0, [3123]),
                (24, 24, 25, 290.0, [3124]),
                (25, 25, 26, 290.0, [3125]),
                (26, 26, 27, 290.0, [3126]),
                (27, 27, 28, 290.0, [3127]),
                (28, 28, 29, 290.0, [3128]),
                (29, 29, 30, 290.0, [3129]),
                (30, 30, 31, 290.0, [3130]),
                (31, 31, 32, 290.0, [3131]),
                (32, 32, 33, 290.0, [3132]),
                (33, 33, 34, 290.0, [3133]),
                (34, 34, 35, 290.0, [3134]),
                (35, 35, 36, 290.0, [3135]),
                (36, 36, 37, 290.0, [3136]),
                (37, 37, 38, 290.0, [3137]),
                (38, 38, 39, 290.0, [3138]),
                (39, 39, 40, 290.0, [3139]),
                (40, 40, 41, 290.0, [3140]),
                (41, 41, 42, 290.0, [3141]),
                (42, 42, 43, 290.0, [3142]),
                (43, 43, 44, 290.0, [3143]),
                (44, 44, 45, 290.0, [3144]),
                (45, 45, 46, 290.0, [3145]),
                (46, 46, 47, 290.0, [3146]),
                (47, 47, 48, 290.0, [3147]),
                (48, 48, 49, 290.0, [3148]),
                (49, 49, 50, 290.0, [3149]),
                (50, 50, 51, 290.0, [3150]),
                (51, 51, 52, 290.0, [3151]),
                (52, 52, 53, 290.0, [3152]),
                (53, 53, 54, 290.0, [3153]),
                (54, 54, 55, 290.0, [3154]),
                (55, 55, 56, 290.0, [3155]),
