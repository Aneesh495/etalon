                (60, 60, 1, 290.0, [3160]),
                (61, 6, 12, 620.0, [3201]),
                (62, 11, 23, 620.0, [3202]),
                (63, 16, 34, 620.0, [3203]),
                (64, 21, 45, 620.0, [3204]),
