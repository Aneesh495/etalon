                (67, 36, 18, 620.0, [3207]),
                (68, 41, 29, 620.0, [3208]),
                (69, 46, 40, 620.0, [3209]),
                (70, 51, 51, 620.0, [3210]),
                (71, 56, 2, 620.0, [3211]),
                (72, 1, 13, 620.0, [3212]),
                (73, 6, 24, 620.0, [3213]),
                (74, 11, 35, 620.0, [3214]),
                (75, 16, 46, 620.0, [3215]),
                (76, 21, 57, 620.0, [3216]),
                (77, 26, 8, 620.0, [3217]),
                (78, 31, 19, 620.0, [3218]),
                (79, 36, 30, 620.0, [3219]),
                (80, 41, 41, 620.0, [3220]),
                (81, 46, 52, 620.0, [3221]),
                (82, 51, 3, 620.0, [3222]),
                (83, 56, 14, 620.0, [3223]),
                (84, 1, 25, 620.0, [3224]),
                (85, 6, 36, 620.0, [3225]),
                (86, 11, 47, 620.0, [3226]),
                (87, 16, 58, 620.0, [3227]),
                (88, 21, 9, 620.0, [3228]),
                (89, 26, 20, 620.0, [3229]),
                (90, 31, 31, 620.0, [3230])
            ]
        in insertLinkList g links

    insertLinkList :: !*OpticalGraph ![(!Int, !Int, !Int, !Real, ![Int])] -> *OpticalGraph
    insertLinkList curG [] = curG
    insertLinkList curG [(lId, u, v, len, spanIds):rest] =
        let spans = [createFiberSpan sId (len / toReal (length spanIds)) standardSmf28 \ sId <- spanIds]
            link = createOpticalLink lId u v len spans
            nextG = addLinkToGraph curG link
        in insertLinkList nextG rest
