import sys
from pathlib import Path

# Add bindings/python to sys.path
REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "bindings" / "python"))

from pyetalon.cli import main

if __name__ == "__main__":
    main()
